{
  "name": "mosaic-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --config apps/editor/vite.config.ts",
    "desktop": "npm run build && electron dist/desktop",
    "build": "node scripts/build.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "release:archive": "node scripts/archive.mjs",
    "release:package": "npm run package && npm run release:archive",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "qualify": "node --expose-gc scripts/qualify.mjs",
    "smoke": "playwright test"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.4",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^45.5.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.10.1",
    "typescript": "5.9",
    "typescript-eslint": "^8.74.0",
    "vite": "^7.3.8",
    "vitest": "^5.1.2"
  },
  "dependencies": {
    "dockview-react": "^8.10.0",
    "immer": "^11.2.13",
    "lucide-react": "^1.81.0",
    "pixi.js": "^8.23.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "allowScripts": {
    "esbuild": true
  }
}
